# Gypsy Jazz Hub — copy to .env and fill what you need.
# First run in Cursor: leave everything commented. PGLite starts empty-auth-ready.

# Postgres (Neon / any Postgres). Empty = embedded PGLite.
# DATABASE_URL=postgres://USER:PASS@HOST/DB?sslmode=require

# Auth. Unset = preview/local Better Auth. "false" = skip login (dev user).
# VITE_AUTH_ENABLED=true
# BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# BETTER_AUTH_URL=http://localhost:3000
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=

# Optional mail + cron (digest, alerts, imports)
# RESEND_API_KEY=
# CRON_SECRET=
# DIGEST_SECRET=

# Optional AI catalog helpers
# XAI_API_KEY=
